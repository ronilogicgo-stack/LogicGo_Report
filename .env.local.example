# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY - never put NEXT_PUBLIC_ in front of this one, and never
# paste it anywhere public. Get it from Supabase Settings -> API ->
# "service_role" key (NOT the anon key). It's required for the Admin's
# "Delete Account" feature, which needs full database access to
# permanently remove a person's login credentials (freeing their email
# for reuse), profile, and all their data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
